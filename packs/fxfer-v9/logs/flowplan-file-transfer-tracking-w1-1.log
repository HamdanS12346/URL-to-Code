  const harvest = async (w, n) => {
    const nd = path.join(dir, n.dir);
    fs.mkdirSync(nd, { recursive: true });
    const lay = await w.page.evaluate((sc) => window.__xp.layer(sc), scope);
    n.windows = lay.windows;

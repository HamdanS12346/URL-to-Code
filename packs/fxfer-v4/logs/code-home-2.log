"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "cd C:\\UI-specs\\URL-to-Code\\packs\\fxfer-v4\\app; Set-Content -LiteralPath .\\tmp_patch_home2.py -Encoding utf8 -Value @'
import re
from pathlib import Path

p = Path(r\"src/screens/home/Page.tsx\")
s = p.read_text(encoding=\"utf-8\")

start = s.find('<ul id=\"mainMenu\"')
if start == -1:
    raise SystemExit('mainMenu not found')
end = s.find('</ul>', start)
if end == -1:
    raise SystemExit('mainMenu </ul> not found')
seg = s[start:end + 5]

# Add flyout behavior flag on the menu root <ul> (what the kit expects)
seg = re.sub(
    r'(<ul\\s+id=\"mainMenu\"["'^>]*)(>)'"',
    lambda m: m.group(0) if 'data-kit-flyout=\"' in m.group(1) else m.group(1) + ' data-kit-flyout=\"side\"' + m.group(2),
    seg,
    count=1,
)

# Remove accidental data-kit-flyout flags from <li> items in this menu
seg = re.sub(r'(<li["'^>]*?)'"\\s+data-kit-flyout=\"side\"', r'\\1', seg)

s = s[:start] + seg + s[end + 5:]

p.write_text(s, encoding=\"utf-8\")
print('patched', p)

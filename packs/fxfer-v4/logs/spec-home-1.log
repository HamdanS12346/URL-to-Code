    list('missing media (facts.md section 17)', r.missing.media);
    list('missing kit widgets/dialogs (facts.md section 18)', r.missing.kit.map((k) => `kit:${k}`));
    for (const u of r.unknown) console.log(`  invented: ${u}`);

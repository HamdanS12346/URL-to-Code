import json
from pathlib import Path

d=json.loads(Path('packs/fxfer-v7/screens/file-transfer-configuration/kit/screen.json').read_text(encoding='utf-8'))
dlg=d['dialogs']['d2']
print('DIALOG d2 |', dlg.get('title'))
widgets=dlg.get('widgets',{})
print('widget ids:', ', '.join(widgets.keys()))
for wid,w in widgets.items():
    items=w.get('items')
    n= len(items) if isinstance(items,list) else 0
    print(f\"  {wid}: kind={w.get('kind')} required={w.get('required')} placeholder={w.get('optionLabel') or w.get('placeholder')} items={n}\")

print('fields:')
for f in dlg.get('fields',[]):
    if not (f.get('label') or f.get('widget') or f.get('required') or f.get('validation')):
        continue
    v=f.get('validation') or {}
    req=v.get('required') if isinstance(v,dict) else None
    regex=v.get('regex') if isinstance(v,dict) else None
    print(f\"- {f.get('label')"'!r} name={f.get('"'name') or f.get('id')} type={f.get('type')} req={f.get('required')} widget={f.get('widget')} reqMsg={req"'!r} regexMsg={regex!r}")

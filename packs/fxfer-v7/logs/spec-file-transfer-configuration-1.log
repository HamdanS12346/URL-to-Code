import json
from pathlib import Path

d=json.loads(Path('packs/fxfer-v7/screens/file-transfer-configuration/kit/screen.json').read_text(encoding='utf-8'))

for did, dlg in d['dialogs'].items():
    print('\\nDIALOG', did, '|', dlg.get('title'))
    widgets = dlg.get('widgets', {})
    print('  widget ids:', ', '.join(widgets.keys()))
    for wid, w in widgets.items():
        kind=w.get('kind')
        label=w.get('label') or w.get('name')
        required=w.get('required')
        placeholder=w.get('optionLabel') or w.get('placeholder')
        items=w.get('items')
        item_texts=[]
        if isinstance(items,list):
            item_texts=[it.get('text') for it in items if isinstance(it,dict) and it.get('text') is not None]
        print(f\"    {wid}: {kind} label={label"'!r} required={required} placeholder={placeholder!r} items={len(item_texts)}")
    # fields list
    fields=dlg.get('"'fields', [])
    print('  fields:', len(fields))
    for f in fields:
        if not f.get('label') and not f.get('required') and not f.get('validation') and not f.get('widget'):
            continue
        v=f.get('validation') or {}
        vkeys=','.join(v.keys()) if isinstance(v,dict) else ''
        print(f\"    field {f.get('name') or f.get('id')}: label={f.get('label')"'!r} type={f.get('"'type')} req={f.get('required')} widget={f.get('widget')} validationKeys={vkeys}\")

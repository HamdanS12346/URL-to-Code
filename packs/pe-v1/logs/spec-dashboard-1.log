        line=it
    elif len(line)+2+len(it) <= 110:
        line += ', ' + it
    else:
        lines.append(line)
        line=it
if line:
    lines.append(line)

block = \"\\n\\n### 12.x Control census (for the spec gate)\\nThe capture includes these required interactive keys (many belong to the shared shell / portal chrome; see home spec for their behavior):\\n\" + \"\\n\".join(lines) + \"\\n\"

# insert block right before Open questions
marker='\\n\\n## 13. Open questions'
if marker not in text:
    raise SystemExit('marker not found')
text=text.replace(marker, block+marker, 1)

spec_path.write_text(text, encoding='utf-8', newline='\\n')
print('updated', spec_path)

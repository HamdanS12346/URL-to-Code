import json
from pathlib import Path

dom=json.loads(Path('packs/pe-v1/screens/dashboard/capture/dom.json').read_text(encoding='utf-8'))['body']

def walk(node):
    yield node
    for c in node.get('k',[]) or []:
        yield from walk(c)

classes_of_interest={'dshbrd-link-panes','dshbrd-panel-container','content-panel-container','content-panel-hdr','content-panel-bdy'}
found=[]
for n in walk(dom):
    cls=n.get('cls') or ''
    for c in classes_of_interest:
        if c in cls.split():
            found.append((c,n))

# print some unique by box/name
for c in ['dshbrd-panel-container','content-panel-container']:
    items=[n for cc,n in found if cc==c]
    print('\\n',c,'count',len(items))
    for n in items[:6]:
        print('  t',n.get('t'),'key',n.get('key'),'id',n.get('id'),'box',n.get('box'))

# search results outer content panel container around searchResultHeader
# find nearest ancestor that has cls content-panel-container and contains key searchResultHeader

def contains_key(node, target):
    if node.get('key')==target:
        return True
    for c in node.get('k',[]) or []:
        if contains_key(c,target):
            return True
    return False

containers=[]
for n in walk(dom):
    cls=(n.get('cls') or '')
    if 'content-panel-container' in cls.split():
        if contains_key(n,'searchResultHeader'):
            containers.append(n)
print('\\nsearchResultHeader containers', len(containers))
for n in containers:
    print('  box', n.get('box'), 'cls', n.get('cls'))

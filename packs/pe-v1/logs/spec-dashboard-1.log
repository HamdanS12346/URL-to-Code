from pathlib import Path
import re
text=Path('packs/pe-v1/screens/dashboard/facts.md').read_text(encoding='utf-8')

def extract(num:str):
    m=re.search(rf'(?m)"'^## {num}'"\\..*"'$'"', text)
    if not m: return None
    start=m.start()
    m2=re.search(r'(?m)"'^## '"\\d+\\..*"'$'"', text[m.end():])
    end=len(text) if not m2 else m.end()+m2.start()
    return text[start:end]
for num in ['6','7','14']:
    s=extract(num)
    print('\\n'+'='*60)
    print('SECTION',num)
    print('='*60)
    print((s or '(missing)')[:20000])

function FtpServerCredentialsBehavior() {
  const { bus } = useKit();
  const suppressSearchResetRef = useRef(false);

  useEffect(() => {
    const showResults = (visible: boolean) => {
      const el = document.getElementById('searchResults');
      if ("'!el) return;
      (el as HTMLElement).style.display = visible ? '"'' : 'none';
    };

    const ensureCriteriaCollapsed = (collapsed: boolean) => {
      const icon = document.getElementById('criteriaPanel');
      if ("'!icon) return;

      const isCollapsed = icon.classList.contains('"'fa-angle-down');
      if (collapsed === isCollapsed) return;

      const toggle = icon.closest('[data-kit-action=\"collapse\"]');
      if ("'!toggle) return;
      toggle.dispatchEvent(new MouseEvent('"'click', { bubbles: true }));
    };

    const onCancel = () => {
      showResults(false);
      ensureCriteriaCollapsed(false);
    };

    const onSearchClickCapture = () => {
      if (suppressSearchResetRef.current) return;
      const checkbox = document.getElementById('showInvalidFTPServerCredentialsCheckBox') as HTMLInputElement | null;
      if (checkbox) checkbox.checked = false;
    };


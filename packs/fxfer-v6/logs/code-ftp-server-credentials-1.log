    const resetButton = document.getElementById('resetButton');
    const cancelButton = document.getElementById('cancelButton');
    const includeInvalidCheckbox = document.getElementById('showInvalidFTPServerCredentialsCheckBox');

    searchButton?.addEventListener('click', onSearchClickCapture, true);
    resetButton?.addEventListener('click', onCancel);
    cancelButton?.addEventListener('click', onCancel);
    includeInvalidCheckbox?.addEventListener('change', onIncludeInvalidChange);

    const unsubscribeSearch = bus.on('search', () => {
      showResults(true);
      window.setTimeout(() => {
        const hasRows = "'!!document.querySelector('"'#FTPServerCredentialsGrid tbody tr');

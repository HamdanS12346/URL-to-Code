      if (closeSummary) {
        e.preventDefault();
        hideSummaryErrors();
      }
    };

    document.addEventListener(\"click\", onClick);
    return () => {
      document.removeEventListener(\"click\", onClick);
      unsubs.forEach((u) => u && u());
    };
  }, [bus]);

  return null;
}

        input.focus();
        input.select();
      }
    };

    const unsubs = [
      bus.on("search", () => hideSummaryErrors()),
      bus.on("reset", () => {
        hideSummaryErrors();
        hideResultsPanel();
        focusFileId();
      }),
    ];

    const onClick = (e: MouseEvent) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;

      const cancel = target.closest("[data-kit-action='"\\\"cancel\\\"]\");
      if (cancel) {
        e.preventDefault();
        hideSummaryErrors();
        hideResultsPanel();
        focusFileId();

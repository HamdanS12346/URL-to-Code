"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "cd C:\\UI-specs\\URL-to-Code; python - <<'PY'
from pathlib import Path
p=Path('packs/fxfer-v6/screens/home/facts.md')
text=p.read_text(encoding='utf-8')

import re

def section(title):
    pat=re.compile(rf\""'^## {re.escape(title)}'"\\n\", re.M)
    m=pat.search(text)
    if not m:
        raise SystemExit(f'missing {title}')
    start=m.start()
    m2=re.search(r\""'^## ", text[m.end():], re.M)
    end=(m.end()+m2.start()) if m2 else len(text)
    return text[start:end]

for t in [
    '"'5. Controls (every interactive element)',
    '6. Validation',
    '7. Interaction styles (measured on the live page)',
    '18. Provider kit harvest (kit/screen.json)'
]:
    s=section(t)
    print('\\n'+'='*80)
    print(s)

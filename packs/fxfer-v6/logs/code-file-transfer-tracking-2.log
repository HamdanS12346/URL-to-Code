// fxfer-v6/file-transfer-tracking: static port of the capture. Behavior comes from spec/UI_SPEC.md + BEHAVIOR.md.
function FileTransferTrackingBehavior() {
  const { bus } = useKit();

  useEffect(() => {
    const hideSummaryErrors = () => {
      const summary = document.querySelector<HTMLElement>("[data-kit-h=\"h1\"]");
      if (summary) summary.style.display = "none";
    };

    const hideResultsPanel = () => {
      const panel = document.getElementById("searchFileTrackingResultsPanel");
      if (panel) panel.style.display = "none";
    };

    const focusFileId = () => {
      const input = document.getElementById("FileId");
      if (input && input instanceof HTMLInputElement) {
        input.focus();
        input.select();
      }
    };

    const unsubs = [
      bus.on("search", () => hideSummaryErrors()),
      bus.on("reset", () => {
        hideSummaryErrors();
        hideResultsPanel();
        focusFileId();
      }),
    ];

    const onClick = (e: MouseEvent) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;

      const cancel = target.closest("[data-kit-action=\"cancel\"]");
      if (cancel) {
        e.preventDefault();
        hideSummaryErrors();
        hideResultsPanel();
        focusFileId();
        return;
      }

      const closeSummary = target.closest("[data-hide=\"alert\"]");
      if (closeSummary) {
        e.preventDefault();
        hideSummaryErrors();
      }
    };

    document.addEventListener("click", onClick);
    return () => {
      document.removeEventListener("click", onClick);
      unsubs.forEach((u) => u && u());
    };
  }, [bus]);

  return null;
}

        continue
    role=w.get('role'); label=w.get('label'); required=w.get('required');
    optionLabel=w.get('optionLabel')
    items=w.get('items')
    print(k, role, 'required' if required else '', 'label',label,'optionLabel',optionLabel,'items',len(items) if isinstance(items,list) else None)


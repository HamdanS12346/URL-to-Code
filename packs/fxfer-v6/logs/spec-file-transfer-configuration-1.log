import json, pathlib
root=pathlib.Path(r\"C:\\UI-specs\\URL-to-Code\\packs\\fxfer-v6\\screens\\file-transfer-configuration\")
data=json.loads((root/'kit'/'screen.json').read_text('utf-8'))
need=json.loads((root/'facts.json').read_text('utf-8'))['required']['kit']

# collect widgets from all places
widgets={}
def collect_widgets(obj):
    if isinstance(obj, dict):
        if 'widgets' in obj and isinstance(obj['widgets'], dict):
            for k,v in obj['widgets'].items():
                widgets[k]=v
        for v in obj.values():
            collect_widgets(v)
    elif isinstance(obj, list):
        for v in obj:
            collect_widgets(v)
collect_widgets(data)

print('collected widgets', len(widgets))
for k in [x for x in need if x.startswith('k')]:
    w=widgets.get(k)

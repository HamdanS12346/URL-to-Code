        await loc.scrollIntoViewIfNeeded({ timeout: 5000 });
        if (s.do === 'hover') await loc.hover({ timeout: 5000 }); else await loc.click({ timeout: 5000 });
        await p.waitForTimeout(st.wait ?? 800);

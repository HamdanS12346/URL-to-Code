  page.on('popup', (p) => { navs.push(p.url()); p.close().catch(() => {}); });
  await page.goto(URL);
  await page.waitForLoadState('networkidle', { timeout: 5000 }).catch(() => {});
  opened = true;
  return { navs, dialogs };
}


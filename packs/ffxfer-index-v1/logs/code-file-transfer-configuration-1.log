  };

  return (
    <KitContext.Provider value={ctx}>
      <div ref={root} data-kit-root="" style={{ display: 'contents' }} onClick={onClick} onMouseOver={onOver} onMouseOut={onOut}
        onFocus={(e) => focusWrap(e, true)} onBlur={(e) => focusWrap(e, false)} onKeyDown={onKey}>

        }
        break;
      }
      case 'save': if (dlg && validate(scope)) Promise.resolve(services?.save?.(dlg, values(scope))).finally(() => closeDialog(dlg)); break;
      case 'cancel': case 'close': if (dlg) closeDialog(dlg); break;

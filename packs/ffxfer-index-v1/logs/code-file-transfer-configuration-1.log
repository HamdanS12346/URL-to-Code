export const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
export const fill = (tpl: string, values: string[]) => tpl.replace(/\{\{c(\d+)\}\}/g, (_, i) => esc(values[+i] ?? ''));


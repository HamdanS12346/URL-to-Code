function validate(root: Element | null) {
  if (!root) return true;
  clearErrors(root);
  let ok = true;
  for (const i of root.querySelectorAll<HTMLInputElement>('input[data-val="true"], select[data-val="true"], textarea[data-val="true"]')) {

t = t.replace('      requestAnimationFrame(() => setCriteriaCollapsed(false));', '      setCriteriaCollapsed(false);')
t = t.replace('      requestAnimationFrame(() => setCriteriaCollapsed(false));', '      setCriteriaCollapsed(false);')

wireup.write_text(t, encoding='utf-8')


from pathlib import Path
import re

# Update Wireup to collapse the criteria panel directly (like the legacy grid databinding hook).
wireup = Path('src/screens/ftp-server-credentials/components/Wireup.tsx')
t = wireup.read_text(encoding='utf-8')

def replace_block(start_marker, end_marker, new_block):
    start = t.index(start_marker)
    end = t.index(end_marker, start)
    return t[:start] + new_block + t[end:]

old_pat = re.compile(r\"\\s+const setCriteriaCollapsed = \\(collapsed: boolean\\) => \\{[\\s\\S]*?\\n\\s+\\};\\n\", re.M)
match = old_pat.search(t)
if not match:
    raise SystemExit('setCriteriaCollapsed block not found')

new_block = \"\"\"
    const setCriteriaCollapsed = (collapsed: boolean) => {
      const icon = document.getElementById('criteriaPanel');
      const body = document.getElementById('FTPServerCredentialsSearch') as HTMLElement | null;
      if ("'!icon || !body) return;

      if (collapsed) {
        body.style.display = '"'none';
        icon.classList.remove('fa-angle-up');
        icon.classList.add('fa-angle-down');
        icon.setAttribute('title', 'Expand');
      } else {
        body.style.display = '';
        icon.classList.remove('fa-angle-down');
        icon.classList.add('fa-angle-up');
        icon.setAttribute('title', 'Collapse');
      }
    };
\"\"\"

t = t[: match.start()] + new_block + t[match.end() :]

# Make collapse happen synchronously on search/reset.

def summarize_dialog(dlg_id):
  dlg=d['dialogs'][dlg_id]
  print('==', dlg_id, dlg.get('title'))
  print('actions:', ', '.join([f\"{a.get('action')}:{a.get('text')}:{a.get('id')}\" for a in dlg.get('actions',[])]))
  # widgets summary
  widgets=dlg.get('widgets',{})
  print('widgets:', ', '.join(sorted(widgets.keys())))
  for wid in sorted(widgets.keys()):
    w=widgets[wid]
    if w.get('kind')=='grid':
      print(f\"  {wid}: grid id={w.get('id')}\")
      continue
    items=w.get('items') or []
    print(f\"  {wid}: {w.get('kind')} name={w.get('name')} required={w.get('required')} optionLabel={w.get('optionLabel')"'!r} items={len(items)} help={w.get('"'help')"'!r}")
  # fields summary (skip blank fake fields)
  fields=[f for f in dlg.get('"'fields',[]) if f.get('id')]
  print('field_count:', len(fields))
  for f in fields:
    # print only validations for interesting
    v=f.get('validation') or {}
    if f.get('required') or v:
      vtxt='; '.join([f\"{k}={v[k]}\" for k in sorted(v.keys())])
      print(f\"  {f['id']}: type={f.get('type')} label={f.get('label')"'!r} required={f.get('"'required')} widget={f.get('widget')} validations={vtxt}\")

summarize_dialog('d1')
print('')
summarize_dialog('d2')

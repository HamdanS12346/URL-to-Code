"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "cd C:\\UI-specs\\URL-to-Code; @'
import re, pathlib
html = pathlib.Path('packs/fxfer-v3/screens/file-transfer-tracking/snapshot/rendered.html').read_text(encoding='utf-8')
for id_ in ['FileId','FileName','TradingPartnerId','FromDate','ToDate','FromSize','ToSize']:
    m = re.search(rf'id=\"{id_}\"["'^>]*'"', html)
    if not m:
        print(id_, 'not found')
        continue
    tag = m.group(0)
    def attr(name):
        mm=re.search(rf'{name}=\"(["'^"]*)"'"', tag)
        return mm.group(1) if mm else None
    print(id_, 'maxlength', attr('maxlength'), 'type', attr('type'), 'name', attr('name'))
    for a in ['data-val-length-max','data-val-regex','data-val-number','data-val-date','data-val-datetime','data-val-regex-pattern']:
        v=attr(a)
        if v:
            print(' ',a,':', v)

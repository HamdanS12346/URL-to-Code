**Simplifying regex matching**

Hmm, the regex didn't match because the ID attribute might be placed after `data-kit-h` or might not be included at all. So, I think the best approach is to find all elements with `data-kit-h="hN"` wherever they are. I can capture the optional ID and the inner text by searching for `data-kit-h="(h\\d+)"`. Then, I'll extract the substring up to the next `>` and the text up to the next `<`. A manual scan sounds like the way to go!
exec
"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "cd C:\\UI-specs\\URL-to-Code; @'
import re, pathlib
s = pathlib.Path('packs/fxfer-v3/screens/file-transfer-tracking/snapshot/rendered.html').read_text(encoding='utf-8')
items=[]
for m in re.finditer(r'data-kit-h=\"(h\\d+)\"', s):
    h=m.group(1)
    start = s.rfind('<', 0, m.start())
    gt = s.find('>', m.end())
    if start==-1 or gt==-1: continue
    tag_open = s[start:gt+1]
    # find end of element
    lt = s.find('<', gt+1)
    body = '' if lt==-1 else s[gt+1:lt].strip()
    id_m = re.search(r'\\sid=\"(["'^"]+)"'"', tag_open)
    id_ = id_m.group(1) if id_m else ''
    items.append((int(h[1:]), h, id_, body))
items.sort()
for _,h,id_,body in items:
    print(f\"{h}\\t{id_}\\t{body}\")
print('count', len(items))

def bracket_group(keys):
    out=[]
    cur=[]
    cur_len=0
    for k in keys:
        tok=f'ctl:{k}'
        add_len=len(tok)+2  # comma+space
        if cur and cur_len+add_len>360:
            out.append('[' + ', '.join(cur) + ']')
            cur=[tok]
            cur_len=len(tok)
        else:
            cur.append(tok)
            cur_len += add_len
    if cur:
        out.append('[' + ', '.join(cur) + ']')
    return out


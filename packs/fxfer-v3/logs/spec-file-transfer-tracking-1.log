import json, pathlib
obj=json.loads(pathlib.Path('packs/fxfer-v3/screens/file-transfer-tracking/capture/dom.json').read_text(encoding='utf-8'))
root=obj['body']

def walk(n):
    yield n
    for c in n.get('c', []) or []:
        yield from walk(c)

matches=[]

from __future__ import annotations

import json
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SCREEN = ROOT / 'packs' / 'fxfer-v3' / 'screens' / 'home'
SPEC_DIR = SCREEN / 'spec'
MENU_DIR = SCREEN / 'menu'


def slugify(label: str) -> str:
    # Matches the existing screenshot names in packs/.../menu/*.png
    s = label.lower()
    s = s.replace('&', 'and')
    s = s.replace('/', '-')
    s = re.sub(r\"["'^a-z0-9]+", "-", s)
    s = re.sub(r"-+", "-", s).strip('"'-')
    return s


def load_json(path: Path):
    return json.loads(path.read_text(encoding='utf-8'))


manifest = load_json(SCREEN / 'manifest.json')
menu = load_json(SCREEN / 'menu.json')

url = manifest['url']
dpr = manifest['dpr']
viewport_w = manifest['css_viewport_width']
viewport_h = manifest['css_viewport_height']

# ---- Menu table generation ----
menu_rows: list[str] = []
menu_rows.append('| module | item | legacy href | notes | evidence |')
menu_rows.append('|---|---|---|---|---|')

for module in menu['modules']:
    module_label = module['label']
    module_png = f\"{slugify(module_label)}.png\"
    module_png_path = MENU_DIR / module_png
    module_ev = f\"[asset:menu.json, asset:menu/{module_png}]\" if module_png_path.exists() else \"[asset:menu.json]\"

    for child in module.get('children', []):
        child_label = child['label']
        child_href = child.get('href') or ''

        notes = 'shown in flyout'
        if module_label == 'File Transfer Services':
            route = {
                'File Transfer Configuration': 'fxfer-v3/file-transfer-configuration',
                'File Transfer Tracking': 'fxfer-v3/file-transfer-tracking',
                'FTP Server Credentials': 'fxfer-v3/ftp-server-credentials',
            }.get(child_label)
            if route:
                notes = f'routes to rebuilt screen "'`{route}`'"'

        menu_rows.append(
            f\"| {module_label} | {child_label} | "'`{child_href}` | {notes} | {module_ev} |"
        )

menu_table = '"'\\n'.join(menu_rows)

# ---- Spec body ----

import { useEffect } from 'react';

const EMPTY_STRINGS = new Set(['', '0']);

function isEmpty(v: string | null | undefined) {
  return v == null || EMPTY_STRINGS.has(v.trim());
}

function clearGeneralMessages() {
  const gm = document.querySelector<HTMLElement>('.gm-container');
  if ("'!gm) return;
  gm.innerHTML = '"'';
  gm.style.display = 'none';
}

function showGeneralError(text: string) {
  const gm = document.querySelector<HTMLElement>('.gm-container');
  if ("'!gm) return;
  gm.innerHTML = '"'';

  const msg = document.createElement('div');
  msg.setAttribute('role', 'alert');
  // Keep it simple: styles come from the ported CSS (if any).
  msg.className = 'alert alert-danger';
  msg.textContent = text;
  gm.appendChild(msg);
  gm.style.display = '';
}

function hideResultsPanel() {
  const panel = document.getElementById('searchFileTransferConfigResultsPanel') as HTMLElement | null;
  if (panel) panel.style.display = 'none';
}

function getCriteriaValues() {
  const configIdSpin = document.querySelector<HTMLInputElement>('[data-kit=\"k1\"] input[role=\"spinbutton\"]');
  const configIdHidden = document.getElementById('ConfigId') as HTMLInputElement | null;

  const configId = (configIdSpin?.value ?? configIdHidden?.value ?? '').trim();
  const configName = (document.getElementById('ConfigName') as HTMLInputElement | null)?.value ?? '';
  const ownerName = (document.getElementById('OwnerName') as HTMLInputElement | null)?.value ?? '';
  const protocol = (document.getElementById('ProtocolList') as HTMLInputElement | null)?.value ?? '';
  const ownerModule = (document.getElementById('SearchModuleList') as HTMLInputElement | null)?.value ?? '';

  return { configId, configName, ownerName, protocol, ownerModule };
}

function hasAnySearchCriteria() {
  const v = getCriteriaValues();
  return "'!(
    isEmpty(v.configId) &&
    isEmpty(v.configName) &&
    isEmpty(v.ownerName) &&
    isEmpty(v.protocol) &&
    isEmpty(v.ownerModule)
  );
}

export default function Wireup() {
  useEffect(() => {
    const next = document.getElementById('"'nextButton') as HTMLInputElement | null;
    const cancel = document.getElementById('cancelButton') as HTMLInputElement | null;
    const reset = document.getElementById('resetButton') as HTMLInputElement | null;

    if ("'!next) return;

    const onSearchClickCapture = (e: Event) => {
      clearGeneralMessages();

      if (!hasAnySearchCriteria()) {
        e.preventDefault();
        // Stop the kit'"'s search handler.
        (e as any).stopImmediatePropagation?.();
        showGeneralError('At least one search criteria is required.');
        hideResultsPanel();
      }
    };

    const onCancelClickCapture = (e: Event) => {
      e.preventDefault();
      (e as any).stopImmediatePropagation?.();
      clearGeneralMessages();

      // Legacy search pages typically \"cancel\" back to a clean state.
      reset?.click();
      hideResultsPanel();
    };

    const onDocChangeCapture = (e: Event) => {
      const t = e.target as HTMLElement | null;
      if ("'!t) return;

      // Any field edit clears the general message area.
      if (
        t.id === '"'ConfigName' ||
        t.id === 'OwnerName' ||
        t.id === 'ConfigId' ||
        t.id === 'SearchModuleList' ||
        t.id === 'ProtocolList'
      ) {
        clearGeneralMessages();
        return;
      }

      if (t.id === 'FileTransferShowInactiveCheckBox') {
        clearGeneralMessages();

        // Legacy filters the existing grid; triggering a new search is close enough
        // (mock data + local, no backend side effects).
        const resultsVisible =
          (document.getElementById('searchFileTransferConfigResultsPanel') as HTMLElement | null)?.style.display "'!== '"'none';
        if (resultsVisible) next.click();
      }
    };

    next.addEventListener('click', onSearchClickCapture, true);
    cancel?.addEventListener('click', onCancelClickCapture, true);
    document.addEventListener('change', onDocChangeCapture, true);

    return () => {
      next.removeEventListener('click', onSearchClickCapture, true);
      cancel?.removeEventListener('click', onCancelClickCapture, true);
      document.removeEventListener('change', onDocChangeCapture, true);
    };
  }, []);

  return null;
}

   {
    "sel": "[data-kit-menu-backdrop-live]",
    "why": "with the backdrop the page appends"
   }
  ]
 },
 {
  "name": "menu-flyout",
  "steps": [
   {
    "do": "click",
    "sel": "[data-kit-action=menu]"
   },
   {
    "do": "hover",
    "sel": "[data-kit-menu] li:has(> .k-menu-popup), [data-kit-menu] li:has(> .k-animation-container)",
    "wait": 900
   }
  ],
  "wait": 900,
  "expect": [
   {
    "sel": "[data-kit-menu] li > .k-menu-popup, [data-kit-menu] li > .k-animation-container",
    "why": "a module flies out on hover"
   }
  ]
 },
 {
  "name": "menu-close",
  "steps": [
   {
    "do": "click",
    "sel": "[data-kit-action=menu]"
   },
   {
    "do": "click",
    "sel": "[data-kit-action=menu-close]"
   }
  ],
  "wait": 600,
  "expect": [
   {
    "sel": "[data-kit-menu]",
    "visible": false,
    "why": "its close icon closes it"
   },
   {
    "sel": "[data-kit-menu-backdrop-live]",
    "visible": false,
    "why": "and removes the backdrop"
   }
  ]
 }
]
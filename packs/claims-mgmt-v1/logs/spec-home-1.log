$menuTreeLines = New-Object System.Collections.Generic.List[string];
foreach ($m in $menu.modules) {
  $menuTreeLines.Add("- $($m.label)");
  foreach ($c in $m.children) {
    $menuTreeLines.Add("  - $($c.label) ($($c.href))");
  }
}
$menuTree = ($menuTreeLines -join "`n");

$menuPicsLines = New-Object System.Collections.Generic.List[string];
$menuPicsLines.Add('"'| module | hover/flyout reference | evidence |');

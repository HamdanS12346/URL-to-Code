from __future__ import annotations
import json, pathlib, re

root = pathlib.Path('packs/claims-mgmt-v1/screens/search-claims')
kit = json.loads((root / 'kit/screen.json').read_text(encoding='utf-8'))
facts = json.loads((root / 'facts.json').read_text(encoding='utf-8'))
widgets = kit['widgets']

label_overrides = {
    'ClaimIdentifiersList': 'Search By',
    'DateTypeList': 'Choose Date Type',
    'MemberByList': 'Choose Member By',
    'ProviderRoleList': 'Choose Provider Role',
    'ProviderByList': '[UNKNOWN: visible label for Provider By]',
    'FromDate': 'Date From',
    'ToDate': 'Date To',
    'DiagnosisTypeList': 'Choose DX Type',
}


def grid_headers(grid_html: str) -> list[str]:
    ths = re.findall(r'<th["'^>]*>(.*?)</th>'"', grid_html, flags=re.S | re.I)
    out: list[str] = []
    for t in ths:
        t = re.sub(r'<["'^>]+>'"', '', t)
        t = ' '.join(t.split())
        if t:
            out.append(t)
    return out


grid_cols: list[str] = []
if 'k17' in kit.get('grids', {}):
    grid_cols = grid_headers(kit['grids']['k17'].get('html') or '')

# widget inventory table
widget_rows: list[str] = []
for wid in sorted(widgets.keys(), key=lambda x: int(x[1:])):
    w = widgets[wid]
    kind = w.get('kind') or ''
    name = w.get('name') or ''
    label = label_overrides.get(name, w.get('label') or '')

    default = ''
    if kind == 'dropdown':
        default = w.get('text') or ''
    elif kind == 'date':
        m = re.search(r'value=\"(["'^"]+)"'"', w.get('html') or '')
        default = m.group(1) if m else (w.get('value') or '')
    elif kind == 'numeric':
        default = str(w.get('value'))
    elif kind == 'grid':
        g = kit.get('grids', {}).get(wid, {})
        default = f\"{g.get('total')} rows (captured)\"

    options = ''
    if kind == 'dropdown':
        items = w.get('items') or []
        if items:
            options = ' | '.join((i.get('text') or '') for i in items)
        else:
            options = '(options loaded dynamically)'
    elif kind == 'grid':
        options = ' | '.join(grid_cols) if grid_cols else '[UNKNOWN: grid columns]'

    help_text = w.get('help') or ''

    widget_rows.append(
        f\"| {wid} | {kind} | {name} | {label} | {default} | {options} | {help_text} | [kit:{wid}] |\"
    )

widget_table = '\\n'.join(widget_rows)

# fields table
fields = [f for f in kit['fields'] if f.get('id')]
field_rows: list[str] = []
for f in fields:
    fid = f['id']
    label = label_overrides.get(fid, f.get('label') or '')

    widget_id = f.get('widget')
    w = widgets.get(widget_id) if widget_id else None
    kind = (w.get('kind') if w else None) or f.get('role') or f.get('type') or 'text'

    default = ''
    if w:
        if w.get('kind') == 'dropdown':
            default = w.get('text') or ''
        elif w.get('kind') == 'date':
            m = re.search(r'value=\"(["'^"]+)"'"', w.get('html') or '')
            default = m.group(1) if m else ''
        elif w.get('kind') == 'numeric':
            default = str(w.get('value'))
        else:
            default = str(w.get('value') or '')
    else:
        v = f.get('value')
        default = '' if v is None else str(v)

    required = 'Yes' if ((w.get('required') if w else f.get('required')) is True) else 'No'

    rules: list[str] = []
    if f.get('maxLength'):
        rules.append(f\"maxLength {f['maxLength']}\")

    if w and w.get('kind') == 'dropdown':
        ol = w.get('optionLabel')
        if ol:
            rules.append(f\"optionLabel \\\"{ol}\\\"\")
        items = w.get('items') or []
        if items:
            rules.append('options: ' + ', '.join((i.get('text') or '') for i in items))
        else:
            rules.append('options: [UNKNOWN: loaded dynamically]')

    if w and w.get('kind') == 'date':
        if w.get('format'):
            rules.append(f\"format {w['format']}\")
        if w.get('min'):
            rules.append(f\"min {w['min']}\")
        if w.get('max'):
            rules.append(f\"max {w['max']}\")

    if w and w.get('kind') == 'numeric':
        rules.append('format currency (c), decimals 2')

    vparams = f.get('validationParams') or {}
    if isinstance(vparams, dict) and vparams.get('regex-pattern'):
        rules.append('regex ' + vparams['regex-pattern'])

    rules_s = '; '.join(rules)

    msgs: list[str] = []
    val = f.get('validation') or {}
    if isinstance(val, dict):
        for k in ['required', 'number', 'date', 'regex', 'length']:

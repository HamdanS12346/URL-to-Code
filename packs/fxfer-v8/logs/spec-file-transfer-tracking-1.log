import re, pathlib
text = pathlib.Path('facts.md').read_text('utf-8')

def extract(start_pat, end_pat):
    m = re.search(start_pat, text, flags=re.M)
    if not m: return None
    start=m.start()
    m2 = re.search(end_pat, text[m.end():], flags=re.M)
    end = (m2.start()+m.end()) if m2 else len(text)
    return text[start:end].strip()

import re, pathlib
text = pathlib.Path('facts.md').read_text('utf-8')
# find section start for Controls
m = re.search(r'"'^## 5'"\\. Controls.*"'$'"', text, flags=re.M)
if not m: raise SystemExit('missing')
start = m.start()
# find next heading
m2 = re.search(r'"'^## 6'"\\.', text[m.end():], flags=re.M)
end = (m2.start()+m.end()) if m2 else len(text)
sec = text[start:end]
lines=sec.splitlines()
cap=320
print('\\n'.join(lines[:cap]))
print('\\n... lines:', len(lines))

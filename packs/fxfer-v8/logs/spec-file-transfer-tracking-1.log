import json
from collections import deque

needle_keys=set(['pageBody','form-resolve-the-following-fo','resetButton','cancelButton','nextButton','FileId','FileName','TradingPartnerId','FromDate','ToDate','SourceLocation','activeScreen'])
needle_ids=set(['pageBody','FileId','FileName','TradingPartnerId','FromDate','ToDate'])
needle_cls_sub=['content-panel-container','content-panel-hdr']

j=json.load(open('capture/dom.json','r',encoding='utf-8'))
root=j['body']
q=deque([(root,'body')])
found=[]
while q:
    node,path=q.popleft()
    key=node.get('key')
    nid=node.get('id')
    cls=node.get('cls','') or ''
    if key in needle_keys or nid in needle_ids or any(s in cls for s in needle_cls_sub):
        found.append((path,node.get('t'),key,nid,cls,node.get('box')))
    for i,ch in enumerate(node.get('k',[]) or []):
        q.append((ch,f\"{path}/{ch.get('t')}[{i}]\"))

# de-dupe by (t,key,id,box)
uniq=[]
seen=set()
for item in found:
    sig=item[1:6]
    if sig in seen: continue
    seen.add(sig)
    uniq.append(item)

for path,t,key,nid,cls,box in uniq:
    print(f\"{t} key={key} id={nid} cls={cls} box={box} path={path}\")

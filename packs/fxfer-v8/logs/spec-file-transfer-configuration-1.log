required_controls = facts['required']['controls']
required_kit = facts['required'].get('kit', [])

# helper to chunk tokens so that the bracket contents stay under 380 chars

def chunk(prefix, items, max_len=380):
    chunks=[]
    cur=[]
    cur_len=0
    for it in items:
        tok=f\"{prefix}:{it}\" if prefix else it
        add_len = (2 if cur else 0) + len(tok)  # \", \"
        if cur and cur_len + add_len > max_len:
            chunks.append(cur)
            cur=[tok]
            cur_len=len(tok)
        else:
            cur.append(tok)
            cur_len += add_len
    if cur:
        chunks.append(cur)
    return chunks

shell = [
    'pageBannerLogo','button','button-medicaid-management-solutions','button-2',
    'AAGMenu.BroadcastMsg','link-messages','AAGMenu.ExternalLinks','link-external-links',
    'AAGMenu.Favorites','link-favorites','AAGMenu.ContactUs','link-contact-us',
    'AAGMenu.MyAccount','AAGMenu.Logout','link-logout','button-main-menu-2','button-8',
    'activeModuleMenu','activeModuleMenuFirstItem','button-help',
    'button-disclaimer','button-website-requirements','button-privacy-policy','button-cookie-policy'
]

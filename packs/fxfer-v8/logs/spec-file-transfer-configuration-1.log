import json, pathlib, textwrap
screen_dir = pathlib.Path(r\"packs/fxfer-v8/screens/file-transfer-configuration\")
ui_spec = screen_dir / \"spec\" / \"UI_SPEC.md\"
tasks = screen_dir / \"spec\" / \"tasks.md\"

manifest = json.loads((screen_dir / \"manifest.json\").read_text(encoding=\"utf-8\"))
kit = json.loads((screen_dir / \"kit\" / \"screen.json\").read_text(encoding=\"utf-8\"))

# helper: list option texts for a kit dropdown widget id

def opt_texts(widget_id: str):
    w = kit.get('widgets', {}).get(widget_id) or kit.get('dialogs', {}).get('d1', {}).get('widgets', {}).get(widget_id) or kit.get('dialogs', {}).get('d2', {}).get('widgets', {}).get(widget_id)
    if not w:
        return None
    items = w.get('items')
    if not isinstance(items, list):
        return None
    return [i.get('text') for i in items if isinstance(i, dict) and 'text' in i]

# precompute a few option lists we want inline
k2_opts = opt_texts('k2') or []
k3_opts = opt_texts('k3') or []

